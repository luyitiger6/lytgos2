<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>io.lytgos</groupId>
  <artifactId>lytgos-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>LytgOS2</name>
  <description>Java-native, privately deployable, auditable enterprise Agent OS</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <picocli.version>4.7.6</picocli.version>
  </properties>

  <modules>
    <module>lytgos-core</module>
    <module>lytgos-provider</module>
    <module>lytgos-memory</module>
    <module>lytgos-tool</module>
    <module>lytgos-channel-cli</module>
    <module>lytgos-web</module>
    <module>lytgos-storage</module>
    <module>lytgos-cli</module>
    <module>lytgos-boot</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-provider</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-memory</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-channel-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.lytgos</groupId>
        <artifactId>lytgos-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
