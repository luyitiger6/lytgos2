<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.lytgos</groupId>
    <artifactId>lytgos-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lytgos-boot</artifactId>
  <name>lytgos-boot</name>
  <description>Spring Boot application and dependency aggregation</description>

  <dependencies>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-provider</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-memory</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-tool</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-channel-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-web</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-storage</artifactId>
    </dependency>
    <dependency>
      <groupId>io.lytgos</groupId>
      <artifactId>lytgos-cli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.lytgos.boot.LytgosApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
